APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.ops-board.dev.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ops_board
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Shared parent of the API + SPA (leading dot) so the session cookie is
# visible from both subdomains.
SESSION_DOMAIN=.ops-board.dev.localhost
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

# --- First-party SPA (Sanctum + CORS) ---------------------------------------
# Hosts allowed to authenticate via session cookies (no scheme, no trailing slash).
SANCTUM_STATEFUL_DOMAINS=app.ops-board.dev.localhost

# Origins that may call the API with credentials. Must match the scheme used
# by the browser.
CORS_ALLOWED_ORIGINS=https://app.ops-board.dev.localhost
CORS_ALLOWED_ORIGINS_PATTERNS=

# Base URL of the Next.js front, used by mail templates that link to the SPA.
FRONTEND_URL=https://app.ops-board.dev.localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
